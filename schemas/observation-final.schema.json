{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Observation: final",
  "description": "Nothing but the type and the counter; the reward is in the step reply.",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "final"
      ]
    },
    "steps_remaining": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    }
  },
  "required": [
    "type",
    "steps_remaining"
  ],
  "additionalProperties": false
}
