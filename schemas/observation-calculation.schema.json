{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Observation: calculation",
  "description": "Result is a decimal string.",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "calculation"
      ]
    },
    "result": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "steps_remaining": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    }
  },
  "required": [
    "type",
    "result",
    "steps_remaining"
  ],
  "additionalProperties": false
}
