{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Findings message",
  "description": "The agent's answer (docs/CONTRACTS.md 6). Extra keys are ignored by the judge, so they are allowed here; the 8 MiB message size is not expressible and is checked by auditgym.findings.",
  "type": "object",
  "properties": {
    "episode_id": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "duplicate_invoice",
              "allocation_gap",
              "fx_error",
              "period_cutoff"
            ]
          },
          "affected_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "claimed_amount_minor": {
            "type": "integer"
          },
          "currency": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0,
            "maxItems": 10
          },
          "explanation": {
            "type": "string",
            "pattern": "^[\\s\\S]{0,1000}$"
          }
        },
        "required": [
          "type",
          "affected_ids",
          "claimed_amount_minor",
          "currency",
          "evidence_ids",
          "explanation"
        ],
        "additionalProperties": true
      },
      "minItems": 0,
      "maxItems": 30
    }
  },
  "required": [
    "episode_id",
    "findings"
  ],
  "additionalProperties": true
}
