{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Episode configuration",
  "description": "Input of reset(seed, config). Every key is optional; the normalized config stored in provenance.json validates against the same schema. Cross-key limits (density, size, pages) are checked by auditgym.config.normalize_config and listed in README.md.",
  "type": "object",
  "properties": {
    "config_version": {
      "type": "string",
      "enum": [
        "1"
      ]
    },
    "size": {
      "type": "object",
      "properties": {
        "invoices": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 10,
            "maximum": 200
          },
          "minItems": 2,
          "maxItems": 2
        },
        "background_pairs": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "currencies": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "KZT",
          "USD",
          "EUR",
          "RUB",
          "CNY",
          "JPY",
          "KWD"
        ]
      },
      "minItems": 0,
      "maxItems": 3
    },
    "base_currency": {
      "type": "string",
      "enum": [
        "KZT",
        "USD",
        "EUR",
        "RUB",
        "CNY",
        "JPY",
        "KWD"
      ]
    },
    "timezone": {
      "type": "string",
      "pattern": "^(\\+(0[0-9]|1[0-3]):(00|30|45)|\\+14:00|-(0[1-9]|1[01]):(00|30|45)|-00:(30|45)|-12:00)$",
      "description": "Fixed offset from -12:00 to +14:00, minutes 00, 30 or 45; -00:00 is refused (use +00:00)."
    },
    "period": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-01$"
        },
        "months": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      },
      "required": [
        "start",
        "months"
      ],
      "additionalProperties": false
    },
    "errors": {
      "type": "object",
      "properties": {
        "duplicate_invoice": {
          "type": "integer",
          "minimum": 0,
          "maximum": 25
        },
        "allocation_gap": {
          "type": "integer",
          "minimum": 0,
          "maximum": 25
        },
        "fx_error": {
          "type": "integer",
          "minimum": 0,
          "maximum": 25
        },
        "period_cutoff": {
          "type": "integer",
          "minimum": 0,
          "maximum": 25
        }
      },
      "required": [],
      "additionalProperties": false,
      "description": "Per type at most 25 (200 invoices / 8 per error); the total with the interaction is at most one issue per 8 invoices and 30 findings, checked by normalize_config."
    },
    "interaction": {
      "type": "string",
      "enum": [
        "none",
        "I1",
        "I2"
      ]
    },
    "allocation_gap_mode": {
      "type": "string",
      "enum": [
        "partial",
        "missing",
        "mixed"
      ],
      "description": "Variant of an allocation_gap: partial (default), missing (the whole closing moved to unallocated) or mixed (drawn per issue)."
    },
    "distractors": {
      "description": "Clean patterns that look suspicious but are not errors: true (all), false (none) or an object that switches single patterns on (missing names are false; docs/DECISIONS.md T).",
      "type": ["boolean", "object"],
      "additionalProperties": false,
      "properties": {
        "split_payments": {"type": "boolean"},
        "overpayments": {"type": "boolean"},
        "advances": {"type": "boolean"},
        "refunds": {"type": "boolean"},
        "repeated_amounts": {"type": "boolean"},
        "boundary_dates": {"type": "boolean"},
        "other_offsets": {"type": "boolean"},
        "weekend_fx": {"type": "boolean"},
        "resent_copies": {"type": "boolean"},
        "shifted_service": {"type": "boolean"}
      }
    },
    "surface_seed": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 115792089237316195423570985008687907853269984665640564039457584007913129639935,
      "description": "An integer from 0 to 2**256 - 1 (MAX_SEED_BITS), or null."
    }
  },
  "required": [],
  "additionalProperties": false
}
