{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "info at the end in train mode",
  "description": "The five numbers of the case; no verdicts on single findings.",
  "type": "object",
  "properties": {
    "reward": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "precision": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "recall": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "f1": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "inspection_steps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    }
  },
  "required": [
    "reward",
    "precision",
    "recall",
    "f1",
    "inspection_steps"
  ],
  "additionalProperties": false
}
