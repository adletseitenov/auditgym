{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "One row of public/fx.csv",
  "description": "Foreign to base currency, rate as a decimal string.",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "source_currency": {
      "type": "string",
      "enum": [
        "KZT",
        "USD",
        "EUR",
        "RUB",
        "CNY",
        "JPY",
        "KWD"
      ]
    },
    "target_currency": {
      "type": "string",
      "enum": [
        "KZT",
        "USD",
        "EUR",
        "RUB",
        "CNY",
        "JPY",
        "KWD"
      ]
    },
    "rate": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?$"
    }
  },
  "required": [
    "date",
    "source_currency",
    "target_currency",
    "rate"
  ],
  "additionalProperties": false
}
