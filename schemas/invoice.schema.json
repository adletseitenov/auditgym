{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "One line of public/invoices.jsonl",
  "description": "Document in its own currency; total_minor is the sum of the items.",
  "type": "object",
  "properties": {
    "doc_id": {
      "type": "string",
      "pattern": "^[^\\s]+$"
    },
    "invoice_id": {
      "type": "string",
      "pattern": "^[^\\s]+$"
    },
    "entity_id": {
      "type": "string",
      "pattern": "^[^\\s]+$"
    },
    "issued_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{2}:[0-9]{2}$"
    },
    "due_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{2}:[0-9]{2}$"
    },
    "currency": {
      "type": "string",
      "enum": [
        "KZT",
        "USD",
        "EUR",
        "RUB",
        "CNY",
        "JPY",
        "KWD"
      ]
    },
    "total_minor": {
      "type": "integer",
      "minimum": 0
    },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "unit_price_minor": {
            "type": "integer",
            "minimum": 0
          },
          "amount_minor": {
            "type": "integer",
            "minimum": 0
          },
          "service_start": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "service_end": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        },
        "required": [
          "description",
          "quantity",
          "unit_price_minor",
          "amount_minor",
          "service_start",
          "service_end"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "doc_id",
    "invoice_id",
    "entity_id",
    "issued_at",
    "due_at",
    "currency",
    "total_minor",
    "line_items"
  ],
  "additionalProperties": false
}
