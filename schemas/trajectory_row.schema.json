{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "One line of trajectories.jsonl",
  "description": "episode_id, step, action, observation, reward, terminated, truncated; the observation validates against the observation-* schema of its type (step 0 is the reset observation).",
  "type": "object",
  "properties": {
    "episode_id": {
      "type": "string"
    },
    "step": {
      "type": "integer",
      "minimum": 0
    },
    "action": {
      "type": [
        "object",
        "null"
      ]
    },
    "observation": {
      "type": "object"
    },
    "reward": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "terminated": {
      "type": "boolean"
    },
    "truncated": {
      "type": "boolean"
    }
  },
  "required": [
    "episode_id",
    "step",
    "action",
    "observation",
    "reward",
    "terminated",
    "truncated"
  ],
  "additionalProperties": false
}
